<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:SecurityType xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="TitleBox">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!ReportTitle.Value</Value>
                    <Style>
                      <FontSize>18pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.25in</Top>
            <Left>0.25in</Left>
            <Height>0.4in</Height>
            <Width>7in</Width>
            <Style />
          </Textbox>
          <Textbox Name="CompanyBox">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!CompanyName.Value</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0in</Top>
            <Left>0.25in</Left>
            <Height>0.25in</Height>
            <Width>4in</Width>
            <ZIndex>3</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="RunInfoBox">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Run: " &amp; Fields!RunDate.Value &amp; " by " &amp; Fields!RunByUser.Value</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <Color>Gray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Right</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0in</Top>
            <Left>4.5in</Left>
            <Height>0.25in</Height>
            <Width>2.75in</Width>
            <ZIndex>4</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="ParamsBox">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Model: " &amp; Fields!ModelColumn.Value &amp; "   Class: " &amp; Fields!ClassFilter.Value &amp; "   Period: " &amp; Fields!StartDate.Value &amp; " - " &amp; Fields!EndDate.Value</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                      <Color>DarkGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.7in</Top>
            <Left>0.25in</Left>
            <Height>0.25in</Height>
            <Width>7in</Width>
            <ZIndex>1</ZIndex>
            <Style />
          </Textbox>
          <Tablix Name="DetailTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>1.1in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2.2in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>0.7in</Width>
                </TablixColumn>
                <TablixColumn>
