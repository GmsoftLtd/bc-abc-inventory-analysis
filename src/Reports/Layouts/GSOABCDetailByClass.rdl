                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=IIF(Fields!ABCClass.Value = "A", "#D5E8D4", IIF(Fields!ABCClass.Value = "B", "#FFF2CC", "#F8CECC"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ItemValue">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
